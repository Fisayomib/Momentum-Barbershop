# Silica Capital — environment
#
# LEAVE THIS FILE ALONE to run in LOCAL MODE (data saved in your browser, no account needed).
#
# To switch to SHARED MODE (everyone in the group sees the same live data):
#   1. Create a free project at https://supabase.com
#   2. Open the SQL Editor, paste in the contents of supabase/schema.sql, and run it
#   3. Copy this file to `.env.local` and fill in the two values below
#      (Supabase dashboard -> Project Settings -> API)
#   4. Restart the dev server
#
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
